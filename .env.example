# Any ONE of these is enough. Never commit a real value.
#
# Gateway (Experiential — a managed proxy in front of TypeSafe):
EXPERIENTIAL_API_KEY=
EXPLABS_API_KEY=
# TypeSafe direct (the official API; a console key goes direct, no proxy):
TYPESAFE_API_KEY=
# OpenRouter (sk-or-...). Used when no other key is present, or with
# --provider openrouter / JEV_PROVIDER=openrouter.
OPENROUTER_API_KEY=
# Unlock python -m jev decide --live (still a charged POST).
JEV_ALLOW_LIVE=
# Optional overrides.
# JEV_PROVIDER=experiential|typesafe|openrouter
# JEV_MODEL=typesafe/jev-1.13
# JEV_URL=https://your-gateway/v1/systemone
